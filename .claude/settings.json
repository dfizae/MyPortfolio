{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npm run tokens:check)",
      "Bash(npm run harness:check)",
      "Bash(npm run harness:check -- --verbose)",
      "Bash(npm run harness:sync)",
      "mcp__ide__getDiagnostics"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/post-edit-check.cjs"],
            "timeout": 30,
            "statusMessage": "토큰·하네스 검사 중"
          }
        ]
      }
    ]
  }
}
